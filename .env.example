# Public site URL (no trailing slash) — used for sitemap, canonical URLs, and Open Graph
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense publisher ID (ca-pub-xxxxxxxxxxxxxxxx)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional: Google site verification code for AdSense / Search Console
NEXT_PUBLIC_ADSENSE_VERIFICATION=

# Create display ad units in AdSense and paste slot IDs below
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_POST_ACTION=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=
